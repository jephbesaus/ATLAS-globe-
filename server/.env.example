# Copiez ce fichier en .env (jamais dans Git) et remplissez-le.
PORT=8080
NODE_ENV=production
# Seul ce compte peut entrer dans le panel admin
ADMIN_EMAIL=jephbesaus07@gmail.com
# Mot de passe initial du panel (utilisé une seule fois pour créer le compte, puis changez-le)
ADMIN_PASSWORD=
# Secret long et aléatoire pour les sessions (ex. 64 caractères)
JWT_SECRET=
# Envoi des e-mails (codes de connexion et de vérification) : https://app.brevo.com
BREVO_API_KEY=
MAIL_FROM=no-reply@atlasglobe.app
MAIL_FROM_NAME=Atlas Globe
# Port UDP du relais des appels vocaux (à ouvrir dans le pare-feu du VPS)
RELAY_PORT=40000
